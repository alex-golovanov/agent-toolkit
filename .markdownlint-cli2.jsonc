{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md"],
  "overrides": [
    {
      "filter": ["plugins/bb-plugin-auto-compact/PLUGIN_OVERVIEW.md"],
      "config": { "MD041": false },
      "combine": "merge",
    },
  ],
  "ignores": [
    "node_modules/**",
    ".venv/**",
    "local/**",
    "corpora/**",
    "profiles/**",
    "exports/**",
    "**/*-metrics.json",
    "**/*-style.md",
    "corpus.md",
    "draft.md",
  ],
}
